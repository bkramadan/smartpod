{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Needed because the shared package writes its imports with ".ts" at the end.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
