# Copy this file to mobile/.env and adjust. Never commit the real .env file.
# Note: every EXPO_PUBLIC_ value is built into the app and visible to anyone who has it,
# so never put secrets here.

# The backend address AS THE PHONE SEES IT. On a real phone "127.0.0.1" means the phone
# itself, so use your computer's Wi-Fi address (e.g. http://192.168.1.20:4000) and start
# the backend with HOST=0.0.0.0.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
