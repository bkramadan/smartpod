# Copy this file to .env and fill in what you need. Every value is optional.

# Port the API listens on.
PORT=4000

# Claude writes the plain-language AI explanations when this key is set.
# Without it the backend uses simple template text. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Which Claude model writes the explanations. Haiku is fast and cheap.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# A dose counts as missed this many minutes after its planned time.
MISSED_AFTER_MINUTES=60

# Where the mock database is saved between restarts. Leave empty to keep data in memory only.
DATA_FILE=data/demo-db.json
