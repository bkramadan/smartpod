# Copy this file to backend/.env and adjust. Never commit the real .env file.

# Address the API listens on. 127.0.0.1 = only this computer can reach it.
# Use 0.0.0.0 to let a phone on the same Wi-Fi reach it while testing the mobile app.
HOST=127.0.0.1
PORT=4000

# How much the server logs: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info
